{
  "name": "nobiliare-translator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nobiliare-Aulico Translator — converts any phrase into the Rancido Stilnterra noble register, in Italian and Chinese, across three levels of courtly refinement.",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && wrangler pages dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "deploy:cf": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
