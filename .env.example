# Vite (client) variables. Everything here is baked into the public bundle,
# so NEVER put API keys in this file. The OpenAI key lives only on the server:
# see .dev.vars.example (local) and `wrangler pages secret put` (production).

# Optional. Set to "demo" to build/run the offline template engine only, with no
# calls to /api/transmute. Leave unset for the default LLM-backed API mode.
VITE_TRANSLATE_MODE=
