# Vite (client) variables. Everything here is baked into the public bundle,
# so NEVER put API keys in this file. Model keys live only on the server:
# see .dev.vars.example (local) and `wrangler pages secret put` (production).

# Optional. Set to "demo" to run the offline template engine only, with no calls
# to /api/transmute (handy for UI work without wrangler). Unset = LLM API mode.
VITE_TRANSLATE_MODE=
